{
  "name": "release-gen",
  "version": "5.0.6",
  "private": true,
  "description": "GitHub Action wrapper for Semantic Release",
  "keywords": [
    "github-action",
    "publish",
    "release",
    "semantic-release"
  ],
  "homepage": "https://github.com/agilecustoms/release-gen",
  "bugs": {
    "url": "https://github.com/agilecustoms/release-gen/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agilecustoms/release-gen.git"
  },
  "license": "MIT",
  "author": "Alexey Chekulaev <chekulaevalexey@gmail.com> (https://github.com/laxa1986)",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "lint": "eslint *.{ts,mjs} \"src/**/*.ts\" \"test/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage --project unit",
    "test-integration": "vitest run --project integration",
    "build": "tsc",
    "run-local": "tsc && node dist/local.js"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "esmock": "^3.0.0",
    "micromatch": "^4.0.8",
    "semantic-release": "^25.0.9"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^6.0.0",
    "@types/micromatch": "^4.0.10",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.15.0",
    "eslint-plugin-import-x": "^4.18.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  },
  "updates-blocked": [
    "typescript 6.0.3 -> 7.x: TS 7 has no JS compiler API and typescript-eslint peer range is <6.1.0. Wait until typescript-eslint supports TS 7, then upgrade",
    "conventional-changelog-conventionalcommits 9.x -> 10.x: v10 needs conventional-changelog-writer 9, semantic-release 25 uses writer 8 (\"Missing helper\" error). Wait until semantic-release upgrades the writer"
  ],
  "allowScripts": {
    "fsevents": true
  }
}
