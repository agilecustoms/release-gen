{
  "name": "release-gen",
  "version": "4.2.14",
  "description": "GitHub Action wrapper for Semantic Release",
  "keywords": [
    "github-action",
    "publish",
    "release",
    "semantic-release"
  ],
  "homepage": "https://github.com/agilecustoms/release-gen",
  "bugs": {
    "url": "https://github.com/agilecustoms/release-gen/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agilecustoms/release-gen.git"
  },
  "license": "MIT",
  "author": "Alexey Chekulaev <chekulaevalexey@gmail.com> (https://github.com/laxa1986)",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=24.0.0"
  },
  "private": true,
  "scripts": {
    "lint": "eslint *.{ts,mjs} \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint:fix": "npm run lint -- --fix",
    "test": "vitest run --coverage",
    "test-coverage": "vitest run --coverage --exclude 'test/integration/**'",
    "build": "tsc",
    "run-local": "tsc && node dist/local.js"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "esmock": "^2.7.8",
    "micromatch": "^4.0.8",
    "semantic-release": "^25.0.9"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/micromatch": "^4.0.10",
    "@types/node": "^24.19.1",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^9.39.5",
    "eslint-plugin-import": "^2.32.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "fsevents": true
  }
}
